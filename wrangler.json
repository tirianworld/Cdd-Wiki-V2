{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdd-wiki",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GITHUB_REPO": "theworldoftirian/dragopedia",
    "GITHUB_BRANCH": "main"
  }
}
